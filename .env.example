# Storage: if both Supabase vars are set, Supabase is used.
# Otherwise the app falls back to a local SQLite file at ./data/spin.db
# (fine for local dev / a single VPS, NOT for Vercel — its filesystem is ephemeral).
# Copy this file to .env.local, fill in, then run `npm run db:check`.
# (NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SECRET_KEY are accepted as alternative names.)
SUPABASE_URL=
# Server-only secret / service_role key (NOT SUPABASE_PUBLISHABLE_KEY). Either name works:
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the deployed micro-site (used for OG/share previews).
NEXT_PUBLIC_SITE_URL=https://spin.webauraindia.com

# Business WhatsApp number (country code, no +).
NEXT_PUBLIC_WHATSAPP_NUMBER=917288052098

# Abuse limits (defaults shown). Per-minute is per server instance; per-hour is
# enforced in the database so it holds across serverless instances.
# Indian mobile carriers put many users behind one IP (CGNAT) — don't set the hourly cap too low.
# RATE_LIMIT_REQUESTS_PER_MINUTE=20
# RATE_LIMIT_NEW_SPINS_PER_HOUR=10
# IP_HASH_SALT=change-me

# Optional: override the SQLite file location.
# SQLITE_PATH=./data/spin.db
